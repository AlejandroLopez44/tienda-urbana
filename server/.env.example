# Copia este archivo como .env y cambia los valores.
PUERTO=3001

# Secreto para firmar los tokens de sesión (JWT). Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cuenta de administrador que se crea la primera vez que arranca el servidor.
# Son credenciales de prueba solo para desarrollo.
ADMIN_EMAIL=admin@asfalto.test
ADMIN_PASSWORD=Asfalto-Demo-2026
